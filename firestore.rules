rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is an authenticated admin
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Products — public read, admin-only write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories — public read, admin-only write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — anyone can create (guest checkout) and count (for order number generation)
    // admin-only read/update/delete
    match /orders/{orderId} {
      allow create: if true;
      allow list:   if true;   // needed for getCountFromServer() in order number generation
      allow read, update, delete: if isAdmin();
    }

    // Admins — each admin can read only their own doc, no client writes
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      // Allow any authenticated admin to update roleId field (for role assignment UI)
      // For stricter control, restrict to users:manage permission — see note above.
      allow update: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create, delete: if false;
    }

    // Roles — readable by any authenticated admin, writable only by users:manage admins
    // Note: Full permission-chain verification (admins/{uid} → roles/{roleId} → permissions)
    // is complex in Firestore rules. This approximation allows any authenticated admin to
    // write roles — for stronger enforcement, use Firebase Admin SDK server-side validation.
    match /roles/{roleId} {
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Settings — public read, admin-only write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications — admin-only read/write + public create
    // Public create allows guest checkout (createOrder) to push new_order
    // notifications without requiring admin auth on the client side.
    // Admins can read/list, update (mark as read) and delete notifications.
    // NOTE: onSnapshot collection listener uses 'list' — must be explicitly allowed.
    match /notifications/{notificationId} {
      allow create: if true;
      allow list:   if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Customers — each customer can read/write only their own profile doc.
    // Matched by request.auth.uid == the document ID (customers/{uid}).
    // No client can read or write another customer's doc.
    match /customers/{customerId} {
      allow read, write: if request.auth != null && request.auth.uid == customerId;
    }
  }
}
